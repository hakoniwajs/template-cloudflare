{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hakoniwa",
  "main": "src/worker.ts",
  // 依存の wrangler (workerd) バージョンに合わせて更新する
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Cache。Gateway (default) はキャッシュせず毎回実行し、内側の CachedPages が
  // ページや OGP 画像をキャッシュする (props でセッションごとに分ける)
  "cache": {
    "enabled": true
  },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "CachedPages": { "type": "worker", "cache": { "enabled": true } }
  },
  // @hakoniwajs/core に同梱される静的アセット (images/style.css 等) を配信する
  "assets": {
    "directory": "./node_modules/@hakoniwajs/core/public"
  },
  // 世界 = 1 DO (SQLite backend)
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "HakoniwaGame" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HakoniwaGame"] }],
  // ターン進行の外部トリガー。15 分ごとに DO の checkTurn() (RPC) を呼ぶ
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // 環境変数は不要。サイト名・フッタ・タイムゾーンなどは管理画面 (/admin) の「サイト設定」で、
  // 管理者はデプロイ後に /admin/setup (Workers のログに出るセットアップコードを入力) で設定する。
  // 任意の secret (X / Discord ログイン、Resend) は `wrangler secret put <NAME>` で登録する。
  // 管理者のメールアドレスを固定したい場合などは、ここに vars を追加する:
  // "vars": { "HAKONIWA_ADMIN_EMAILS": "you@example.com" }
}
